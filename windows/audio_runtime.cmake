# Pinned LGPL libmpv build with the complete parametric audio filters.
# The MediaKit audio package's reduced FFmpeg lacks bass/treble filters.
set(MUSIC_TIME_MPV_SHA256 "8b61f89716f31a6a1a3c85dc9a16bd7c57c77062b843af8cc8b78f6b5912d2e9")
set(MUSIC_TIME_MPV_DLL_SHA256 "0c05c3ae5f54563dcd69bed60c69d4baa0a5c19f95a044c5c4c0a253197be41f")
set(MUSIC_TIME_MPV_URL "https://github.com/zhongfly/mpv-winbuild/releases/download/2026-11-02-a687796d9d/mpv-dev-lgpl-x86_64-20261102-git-a687796d9d.7z")
set(MUSIC_TIME_MPV_MIRROR "https://github.com/eugilvando/Music-Time-Player/releases/download/v2.7.1/mpv-dev-lgpl-x86_64-20261102-git-a687796d9d.7z")
set(MUSIC_TIME_MPV_DIR "${CMAKE_BINARY_DIR}/music_time_mpv")
set(MUSIC_TIME_MPV_ARCHIVE "${MUSIC_TIME_MPV_DIR}/mpv-lgpl.7z")
if(DEFINED FLUTTER_TARGET_PLATFORM AND NOT FLUTTER_TARGET_PLATFORM STREQUAL "windows-x64")
  message(FATAL_ERROR "The pinned Music Time audio runtime requires Windows x64")
endif()
file(MAKE_DIRECTORY "${MUSIC_TIME_MPV_DIR}")
if(NOT EXISTS "${MUSIC_TIME_MPV_ARCHIVE}")
  # Upstream retains daily archives for only 30 days; keep an exact release mirror.
  file(DOWNLOAD "${MUSIC_TIME_MPV_MIRROR}" "${MUSIC_TIME_MPV_ARCHIVE}"
       STATUS MUSIC_TIME_MPV_DOWNLOAD TLS_VERIFY ON)
  list(GET MUSIC_TIME_MPV_DOWNLOAD 0 MUSIC_TIME_MPV_DOWNLOAD_CODE)
  if(NOT MUSIC_TIME_MPV_DOWNLOAD_CODE EQUAL 0)
    file(DOWNLOAD "${MUSIC_TIME_MPV_URL}" "${MUSIC_TIME_MPV_ARCHIVE}"
         EXPECTED_HASH SHA256=${MUSIC_TIME_MPV_SHA256} TLS_VERIFY ON)
  endif()
endif()
file(SHA256 "${MUSIC_TIME_MPV_ARCHIVE}" MUSIC_TIME_MPV_ACTUAL)
if(NOT MUSIC_TIME_MPV_ACTUAL STREQUAL MUSIC_TIME_MPV_SHA256)
  message(FATAL_ERROR "Music Time audio archive checksum mismatch")
endif()
if(NOT EXISTS "${MUSIC_TIME_MPV_DIR}/libmpv-2.dll")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${MUSIC_TIME_MPV_ARCHIVE}"
                  WORKING_DIRECTORY "${MUSIC_TIME_MPV_DIR}" RESULT_VARIABLE MUSIC_TIME_MPV_EXTRACT)
  if(NOT MUSIC_TIME_MPV_EXTRACT EQUAL 0)
    message(FATAL_ERROR "Could not extract Music Time audio runtime")
  endif()
endif()
file(SHA256 "${MUSIC_TIME_MPV_DIR}/libmpv-2.dll" MUSIC_TIME_MPV_DLL_ACTUAL)
if(NOT MUSIC_TIME_MPV_DLL_ACTUAL STREQUAL MUSIC_TIME_MPV_DLL_SHA256)
  message(FATAL_ERROR "Music Time audio library checksum mismatch")
endif()
list(FILTER PLUGIN_BUNDLED_LIBRARIES EXCLUDE REGEX "[/\\]libmpv-2\\.dll$")
list(APPEND PLUGIN_BUNDLED_LIBRARIES "${MUSIC_TIME_MPV_DIR}/libmpv-2.dll")
